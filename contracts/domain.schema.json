{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "公园节令联名履约领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COLLABORATION_REGISTERED",
        "CULTURAL_ELEMENT_LICENSED",
        "LICENSE_SCOPE_NARROWED",
        "DESIGN_CLEARED",
        "DESIGN_VERSION_SUPERSEDED",
        "RECIPE_REGISTERED",
        "RECIPE_REVISED",
        "RECIPE_FLAVOR_INSPECTION_FAILED",
        "CAPACITY_DECLARED",
        "CAPACITY_CONSUMED",
        "LABEL_VERSION_APPROVED",
        "LABEL_VERSION_WITHDRAWN",
        "FOOD_BATCH_PRODUCED",
        "NONFOOD_COMPONENT_RECEIVED",
        "LOT_LABEL_REFRESHED",
        "COMPONENT_ACCEPTED",
        "COMPONENT_QUARANTINED",
        "COMPONENT_ALLOCATED",
        "COMPONENT_SCRAPPED",
        "COMPONENT_RECALLED",
        "BUNDLE_DEFINED",
        "BUNDLE_BATCH_ASSEMBLED",
        "BUNDLE_RELEASED",
        "BUNDLE_BATCH_BLOCKED",
        "BUNDLE_BATCH_DISPOSED",
        "BUNDLE_BATCH_RECALLED",
        "CHANNEL_QUOTA_OPENED",
        "QUOTA_SUPPLIED",
        "QUOTA_SUPPLY_QUARANTINED",
        "QUOTA_RESERVED",
        "QUOTA_RESERVATION_CONFIRMED",
        "QUOTA_RESERVATION_RELEASED",
        "ORDER_RESERVED",
        "CUSTOMER_SELECTIONS_CONFIRMED",
        "PAYMENT_RECEIVED",
        "ORDER_CANCELLED",
        "PICKUP_COMPLETED",
        "SHIPMENT_DISPATCHED",
        "SHIPMENT_DELIVERED",
        "DAMAGE_REPORTED",
        "REPLACEMENT_SHIPPED",
        "REPLACEMENT_DELIVERED",
        "ORDER_FULFILLMENT_HOLD",
        "ORDER_RECALL_NOTICE",
        "REMEDY_COMPLETED",
        "SETTLEMENT_CLEARED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "collaboration_design",
        "cultural_license",
        "food_recipe",
        "production_capacity",
        "label_catalog",
        "component_lot",
        "bundle_definition",
        "bundle_batch",
        "channel_quota",
        "customer_order",
        "partner_settlement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
